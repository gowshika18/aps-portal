# Base URL for the Backend REST API (must end with /api)
# Local development:
# VITE_API_URL=http://localhost:5000/api
#
# Production (Render, Railway, custom domain):
# VITE_API_URL=https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api
