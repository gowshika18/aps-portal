# ========================================================
# College Placement Aptitude Portal - Backend Environment Variables
# ========================================================

# 1. Database Connection String (PostgreSQL)
# Local Development (embedded or local PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aptitude_portal?schema=public"
#
# Production (Neon, Supabase, Render PostgreSQL, Railway, AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/aptitude_portal?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/aptitude_portal?schema=public"

# 2. JWT Authentication Secrets
# Generate strong 64-character random strings for production:
# (e.g., using: openssl rand -base64 48 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-replace-in-production-min-32-chars"

# 3. Server Configuration
# In cloud environments (Render, Railway, Fly.io, Heroku), PORT is injected automatically.
PORT=5000
NODE_ENV="production"

# 4. Frontend Origin(s) for CORS & Cross-Origin Cookies
# Multiple origins can be comma-separated:
# FRONTEND_URL="https://your-frontend.vercel.app,https://your-custom-domain.com"
FRONTEND_URL="http://localhost:5173"
